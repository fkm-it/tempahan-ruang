{
  "key": "aduan",
  "name": "Aduan",
  "label": "Aduan",
  "labelPlural": "Aduan",
  "icon": "inbox",
  "description": "Hantar aduan atau permintaan dan jejak statusnya.",
  "refFormat": "ADU-{YYYY}-{SEQ4}",
  "access": {
    "create": "PUBLIC",
    "list": "OWN",
    "edit": "OWNER",
    "delete": "OWNER",
    "ownerEditStatuses": [
      "BARU"
    ]
  },
  "statuses": [
    {
      "value": "BARU",
      "label": "Baharu",
      "tone": "info"
    },
    {
      "value": "DALAM_TINDAKAN",
      "label": "Dalam tindakan",
      "tone": "warn"
    },
    {
      "value": "SELESAI",
      "label": "Selesai",
      "tone": "success"
    },
    {
      "value": "DITOLAK",
      "label": "Ditolak",
      "tone": "danger"
    }
  ],
  "statusRole": "ADMIN",
  "notify": {
    "adminsOnCreate": true,
    "ownerOnStatus": true
  },
  "titleField": "tajuk",
  "subtitleField": "kategori",
  "nav": {
    "user": true,
    "admin": true,
    "order": 10
  },
  "publicForm": {
    "title": "Borang Aduan",
    "intro": "Tiada akaun? Hantar aduan anda di sini. Simpan nombor rujukan untuk semakan.",
    "successMessage": "Aduan anda telah diterima. Kami akan menghubungi anda melalui email.",
    "contactEmailField": "email",
    "nameField": "nama"
  },
  "fields": [
    {
      "key": "nama",
      "label": "Nama penuh",
      "type": "string",
      "required": true,
      "max": 80,
      "publicOnly": true,
      "search": true
    },
    {
      "key": "email",
      "label": "Email",
      "type": "email",
      "required": true,
      "publicOnly": true,
      "hint": "Status aduan akan dimaklumkan ke email ini."
    },
    {
      "key": "tajuk",
      "label": "Tajuk",
      "type": "string",
      "required": true,
      "max": 120,
      "list": true,
      "search": true
    },
    {
      "key": "kategori",
      "label": "Kategori",
      "type": "category",
      "list": true,
      "filter": true
    },
    {
      "key": "keutamaan",
      "label": "Keutamaan",
      "type": "enum",
      "default": "SEDERHANA",
      "list": true,
      "filter": true,
      "options": [
        {
          "value": "RENDAH",
          "label": "Rendah"
        },
        {
          "value": "SEDERHANA",
          "label": "Sederhana"
        },
        {
          "value": "TINGGI",
          "label": "Tinggi"
        }
      ]
    },
    {
      "key": "lokasi",
      "label": "Lokasi",
      "type": "string",
      "max": 120,
      "placeholder": "cth. Blok A, Aras 2"
    },
    {
      "key": "keterangan",
      "label": "Keterangan",
      "type": "text",
      "required": true,
      "min": 10,
      "max": 2000,
      "search": true
    },
    {
      "key": "lampiran",
      "label": "Gambar / dokumen",
      "type": "files",
      "maxFiles": 3,
      "public": false
    },
    {
      "key": "catatanPentadbir",
      "label": "Catatan dalaman",
      "type": "text",
      "max": 1000,
      "adminOnly": true,
      "hint": "Hanya dilihat pentadbir."
    }
  ]
}
